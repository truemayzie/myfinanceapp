# Клиент (Vite, используется при сборке фронта на Vercel)
# Необязательно: по умолчанию в проде используется /api на том же домене.
VITE_API_BASE=/api

# Серверные функции (Vercel, НЕ попадают в клиент)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=https://<your-vercel-app>.vercel.app

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
